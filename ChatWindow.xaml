<Window x:Class="EasyShader.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource t_ChatTitle}" Height="600" Width="700" Background="#151515" 
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F0F0F" BorderBrush="#2C2C2C" BorderThickness="1">
            <TextBox x:Name="ChatBox" IsReadOnly="True" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" TextWrapping="Wrap" Padding="10" VerticalScrollBarVisibility="Auto"/>
        </Border>
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Border Background="#0F0F0F" BorderBrush="#333" BorderThickness="1">
                <TextBox x:Name="InputBox" Height="60" Background="Transparent" Foreground="White" BorderThickness="0" TextWrapping="Wrap" CaretBrush="White" Padding="5" AcceptsReturn="True" PreviewKeyDown="InputBox_PreviewKeyDown"/>
            </Border>
            <Button Content="{DynamicResource t_Send}" Grid.Column="1" Margin="10,0,0,0" Background="#007FFF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>