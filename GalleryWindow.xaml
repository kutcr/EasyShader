<Window x:Class="EasyShader.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource t_Gallery}" Height="750" Width="1000" Background="#151515" 
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource t_Gallery}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GalleryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1B1B1B" CornerRadius="2" Margin="0,0,0,15" BorderBrush="#2C2C2C" BorderThickness="1">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#050505" CornerRadius="1">
                                    <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0">
                                    <TextBlock Text="{Binding Time}" Foreground="#555" FontSize="10" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Prompt}" Foreground="#FFF" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Border Background="#0F0F0F" Padding="5">
                                        <TextBox Text="{Binding Code, Mode=OneWay}" Height="70" IsReadOnly="True" Background="Transparent" Foreground="#78DCE8" BorderThickness="0" FontSize="10" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="复制代码" Click="Copy_Click" Background="#333" Foreground="White" Height="28" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="删除" Click="Delete_Click" Background="#441111" Foreground="#FF6666" Height="28" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>