<Window x:Class="EasyShader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource t_SetTitle}" Height="400" Width="450" Background="#151515" Foreground="#E0E0E0" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="UEButton" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UEPrimaryButton" TargetType="Button" BasedOn="{StaticResource UEButton}">
            <Setter Property="Background" Value="#007FFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2299FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="{DynamicResource t_ApiUrl}" FontSize="10" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
            <Border Background="#0F0F0F" CornerRadius="2" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,15">
                <TextBox x:Name="UrlBox" Height="28" Background="Transparent" Foreground="#CCC" BorderThickness="0" Padding="5" CaretBrush="White"/>
            </Border>
            <TextBlock Text="{DynamicResource t_ApiKey}" FontSize="10" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
            <Border Background="#0F0F0F" CornerRadius="2" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,15">
                <TextBox x:Name="KeyBox" Height="28" Background="Transparent" Foreground="#CCC" BorderThickness="0" Padding="5" CaretBrush="White"/>
            </Border>
            <TextBlock Text="{DynamicResource t_Model}" FontSize="10" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
            <Border Background="#0F0F0F" CornerRadius="2" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,25">
                <TextBox x:Name="ModelBox" Height="28" Background="Transparent" Foreground="#CCC" BorderThickness="0" Padding="5" CaretBrush="White"/>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TestBtn" Content="{DynamicResource t_Test}" Grid.Column="0" Height="35" Style="{StaticResource UEButton}" Margin="0,0,5,0" Click="Test_Click"/>
                <Button Content="{DynamicResource t_Save}" Grid.Column="1" Height="35" Style="{StaticResource UEPrimaryButton}" Margin="5,0,0,0" Click="Save_Click"/>
            </Grid>
            <TextBlock x:Name="TestStatus" Text="" Foreground="#00E676" FontSize="11" Margin="0,10,0,0" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>